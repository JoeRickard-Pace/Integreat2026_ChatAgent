# Public frontend config only for non-secret values
VITE_CHAT_API_URL=
VITE_GETSTATES_API_URL=
VITE_SETCANCONTACT_API_URL=

# Do not put secret API keys in VITE_* values if they are required by the browser.
# Keep secrets on the server instead, for example in Netlify Functions or another backend.
# Example server-only values:
# CHAT_API_URL=
# CHAT_API_KEY=
# GETSTATES_API_URL=
# GETSTATES_API_KEY=
# SETCANCONTACT_API_URL=
# SETCANCONTACT_API_KEY=

# Optional local-only overrides if needed during development:
# VITE_CHAT_API_KEY=
# VITE_GETSTATES_API_KEY=
# VITE_SETCANCONTACT_API_KEY=
